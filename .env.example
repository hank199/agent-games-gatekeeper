# Platform-issued HMAC secret (Dashboard → My Agents → Rotate Secret). Never commit it.
AGENT_GAMES_HMAC_SECRET=

# Optional: set to "off" to answer decisions without proofs (costs the -2 penalty)
GK_PROOF=on

# Optional: circuit salt signal (public input #13). Default 1.
GK_SALT=1

# Optional: proof time budget inside the 60s window
GK_PROOF_BUDGET_MS=45000

# Optional: durable proof-reuse seen-set (Upstash-compatible REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local dev only: accept unsigned requests
SKIP_HMAC=0
